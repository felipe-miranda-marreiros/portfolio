---
import type { Locale } from "../fixtures/profile";
import { translator } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
---

<section class="holding">
  <h1 class="holding__title">{t("holdingTitle")}</h1>
  <p class="holding__body">{t("holdingBody")}</p>
</section>

<style>
  .holding {
    align-self: center;
    width: 100%;
    max-width: var(--size-container-page);
    margin-inline: auto;
    padding: var(--space-section) var(--space-page-inline);
  }

  .holding__title {
    margin: 0;
    max-width: var(--text-measure-lead);
    font: var(--text-headline);
    letter-spacing: var(--text-tracking-headline);
    text-wrap: balance;
  }

  .holding__body {
    margin: var(--space-stack-md) 0 0;
    color: var(--color-text-muted);
    font: var(--text-lead);
  }
</style>
