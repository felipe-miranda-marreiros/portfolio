---
import type { Locale } from "../fixtures/profile";
import { translator } from "../i18n";

interface Props {
  locale: Locale;
  skills: string[];
}

const { locale, skills } = Astro.props;
const t = translator(locale);
---

{
  skills.length > 0 && (
    <section class="ui-work-band ui-inverse" aria-labelledby="stack">
      <div class="ui-work-band__inner">
        <h2 class="ui-work-band__label" id="stack">
          {t("stack")}
        </h2>
        <ul class="ui-work-band__list">
          {skills.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      </div>
    </section>
  )
}
