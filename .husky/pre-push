# Enforce branch names on push; the rule itself lives in scripts/check-branch-name.sh
zero=0000000000000000000000000000000000000000

status=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # skip deletions and non-branch refs (tags)
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

  sh scripts/check-branch-name.sh "${remote_ref#refs/heads/}" || status=1
done

exit $status
