{
  "name": "portfolio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky",
    "test": "bun test",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "dev:portfolio": "bun --filter @portfolio/portfolio dev",
    "build": "bun --filter '*' build"
  }
}
